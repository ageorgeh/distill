{
  "name": "distill-workspace",
  "version": "1.5.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelfaj/distill"
  },
  "scripts": {
    "install:local": "pnpm install && pnpm build && cd packages/cli && pnpm link . --global",
    "build:bins": "bun run scripts/build-binaries.ts",
    "sync:platforms": "bun run scripts/sync-platform-packages.ts",
    "build": "pnpm run build:bins && pnpm run sync:platforms",
    "prepare:publish-platforms": "bun run scripts/apply-platform-metadata.ts",
    "smoke:pack": "bun run scripts/smoke-packages.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test test/e2e.test.ts",
    "release:check": "bun run scripts/release-check.ts",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run release:check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
